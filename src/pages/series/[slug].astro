---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getSeries, type Series } from '../../lib/series';

export async function getStaticPaths() {
  const all = await getSeries();
  return all.map((s) => ({ params: { slug: s.slug }, props: { series: s } }));
}

const { series } = Astro.props as { series: Series };

const large = await Promise.all(
  series.photos.map(async (p) => {
    const img = await getImage({ src: p.image, widths: [1200, 2000, 2800], format: 'webp' });
    return {
      src: img.src,
      srcset: img.srcSet.attribute,
      width: p.image.width,
      height: p.image.height,
      color: p.color,
      title: p.title,
      description: p.description,
      location: p.location,
    };
  }),
);
const og = await getImage({ src: series.cover.image, width: 1200, format: 'jpg' });
---

<Base
  title={series.title}
  description={series.description || `${series.title} — photo series by lrdxg`}
  bg={series.bg}
  fg={series.fg}
  muted={series.muted}
  image={og.src}
>
  <section class="intro">
    <h1>{series.title}</h1>
    <div class="intro-meta">
      {series.description && <p>{series.description}</p>}
      <span class="mono">
        {series.year && <>{series.year} · </>}
        {series.photos.length} photos
      </span>
    </div>
  </section>

  <section class="photos" aria-label="Фотографии">
    {
      series.photos.map((p, i) => (
        <button
          class="photo"
          type="button"
          data-index={i}
          style={`background:${p.color};aspect-ratio:${p.image.width}/${p.image.height}`}
          aria-label={`Открыть: ${p.title || `фото ${i + 1}`}`}
        >
          <Image
            src={p.image}
            alt={p.title || `${series.title}, ${i + 1}`}
            widths={[480, 800, 1200]}
            sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
        </button>
      ))
    }
  </section>

  <Lightbox photos={large} seriesTitle={series.title} />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
    padding: clamp(2rem, 6vw, 5rem) var(--gutter) clamp(1.5rem, 4vw, 3rem);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 7vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }
  h1::after {
    content: '.';
    color: var(--accent);
  }
  .intro-meta {
    color: var(--muted);
    max-width: 34rem;
  }
  .intro-meta p {
    margin: 0 0 0.75rem;
    color: var(--fg);
  }
  .mono {
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .photos {
    columns: 3 320px;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
    padding: 0 var(--gutter);
  }
  .photo {
    display: block;
    width: 100%;
    margin: 0 0 clamp(0.75rem, 2vw, 1.5rem);
    padding: 0;
    border: 0;
    cursor: zoom-in;
    break-inside: avoid;
    overflow: hidden;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .photo:hover img {
    transform: scale(1.02);
  }
  .photo:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
