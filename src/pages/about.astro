---
import Base from '../layouts/Base.astro';
import { Content } from '../content/about.md';
---

<Base title="About">
  <article class="about">
    <h1>about</h1>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
    padding: clamp(2rem, 8vw, 6rem) var(--gutter) 0;
    max-width: 72rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }
  h1::after {
    content: '.';
    color: var(--accent);
  }
  .prose {
    font-size: 1.1rem;
    max-width: 38rem;
  }
  .prose :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    font-size: 0.8rem;
    font-family: var(--mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-top: 2.5rem;
  }
  .prose :global(ul) {
    list-style: none;
    padding: 0;
  }
  .prose :global(a) {
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--accent);
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
  }
  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
