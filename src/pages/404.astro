---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="nf">
    <h1>404</h1>
    <p><a href="/">← back to lrdxg</a></p>
  </section>
</Base>

<style>
  .nf {
    padding: clamp(3rem, 12vw, 8rem) var(--gutter) 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(4rem, 15vw, 10rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }
  h1::after {
    content: '.';
    color: var(--accent);
  }
  a {
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
</style>
