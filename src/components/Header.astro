---
import { getSeries } from '../lib/series';

const series = await getSeries();
const path = Astro.url.pathname;
---

<header class="site-header">
  <a href="/" class="logo" aria-label="lrdxg — на главную">lrdxg</a>

  <nav aria-label="Основное меню">
    <ul class="menu">
      <li class="has-dropdown">
        <button
          class="menu-link"
          type="button"
          aria-expanded="false"
          aria-controls="series-menu"
          data-dropdown
          aria-current={path.startsWith('/series') ? 'page' : undefined}
        >
          series <span class="caret" aria-hidden="true">▾</span>
        </button>
        <ul id="series-menu" class="dropdown">
          {
            series.map((s) => (
              <li>
                <a href={`/series/${s.slug}/`} aria-current={path.startsWith(`/series/${s.slug}`) ? 'page' : undefined}>
                  <span>{s.title}</span>
                  {s.year && <span class="year">{s.year}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      <li>
        <a href="/about/" class="menu-link" aria-current={path.startsWith('/about') ? 'page' : undefined}>about</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Тап/клик открывает выпадашку (на десктопе она ещё и по hover).
  const btn = document.querySelector<HTMLButtonElement>('[data-dropdown]');
  const li = btn?.closest('.has-dropdown');
  if (btn && li) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      li.classList.toggle('open', open);
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      set(btn.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('click', (e) => {
      if (!li.contains(e.target as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && li.classList.contains('open')) {
        set(false);
        btn.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem var(--gutter);
    background: var(--bg);
    color: var(--fg);
  }

  .logo {
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.04em;
    line-height: 1;
    color: inherit;
    text-decoration: none;
  }
  .logo::after {
    content: '.';
    color: var(--accent);
  }

  .menu {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-link {
    font: inherit;
    font-size: 0.95rem;
    color: inherit;
    background: none;
    border: 0;
    padding: 0.25rem 0;
    cursor: pointer;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s;
  }
  .menu-link:hover,
  .menu-link:focus-visible,
  .menu-link[aria-current='page'],
  .has-dropdown.open > .menu-link {
    border-bottom-color: var(--accent);
    outline: none;
  }
  .caret {
    display: inline-block;
    font-size: 0.7em;
    transition: transform 0.15s;
  }
  .has-dropdown.open .caret {
    transform: rotate(180deg);
  }

  .has-dropdown {
    position: relative;
  }
  .dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 14rem;
    max-width: calc(100vw - 2 * var(--gutter));
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid currentColor;
    box-shadow: 4px 4px 0 var(--accent);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
  }
  /* мостик, чтобы hover не терялся в зазоре */
  .dropdown::before {
    content: '';
    position: absolute;
    inset: -0.6rem 0 auto 0;
    height: 0.6rem;
  }
  .has-dropdown.open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  @media (hover: hover) {
    .has-dropdown:hover .dropdown {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  .dropdown a {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.55rem 1rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .dropdown a:hover,
  .dropdown a:focus-visible,
  .dropdown a[aria-current='page'] {
    background: var(--accent);
    color: #fff;
    outline: none;
  }
  .year {
    font-family: var(--mono);
    font-size: 0.8em;
    opacity: 0.6;
  }
</style>
